{
  "name": "anticheat-student-client",
  "version": "1.0.0",
  "description": "AntiCheat Quiz Platform — Secure Student Exam Client",
  "main": "dist/main.js",
  "scripts": {
    "dev": "npm run build && electron dist/main.js --no-sandbox",
    "build": "esbuild src/main.ts --bundle --platform=node --external:electron --outfile=dist/main.js",
    "start": "electron dist/main.js --no-sandbox",
    "package": "electron-builder"
  },
  "dependencies": {
    "axios": "^1.6.7",
    "socket.io-client": "^4.7.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.25",
    "electron": "^25.9.8",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.27.3",
    "typescript": "^5.4.2",
    "vite": "^7.3.1",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "edu.anticheat.student",
    "productName": "AntiCheat Quiz Client",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
