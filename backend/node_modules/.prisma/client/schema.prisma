// AntiCheat Quiz Platform — Prisma Schema (SQLite for local dev/testing)
// Switch datasource to PostgreSQL for production

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// Note: SQLite does not support native enums.
// Role values: STUDENT | PROFESSOR | ADMIN
// SessionStatus values: PENDING | ACTIVE | COMPLETED | TERMINATED | FLAGGED
// FlagSeverity values: LOW | MEDIUM | HIGH

model User {
  id        String   @id @default(uuid())
  googleId  String   @unique @map("google_id")
  name      String
  email     String   @unique
  role      String   @default("STUDENT")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  exams    Exam[]
  sessions Session[]

  @@map("users")
}

model Exam {
  id         String    @id @default(uuid())
  ownerId    String    @map("owner_id")
  title      String
  configJson String    @map("config_json") // JSON stored as text in SQLite
  startTime  DateTime? @map("start_time")
  duration   Int // in minutes
  isActive   Boolean   @default(false) @map("is_active")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  owner    User      @relation(fields: [ownerId], references: [id])
  sessions Session[]

  @@map("exams")
}

model Session {
  id                String    @id @default(uuid())
  examId            String    @map("exam_id")
  userId            String    @map("user_id")
  sessionToken      String    @unique @map("session_token")
  startedAt         DateTime? @map("started_at")
  endedAt           DateTime? @map("ended_at")
  status            String    @default("PENDING")
  daemonAttestation String?   @map("daemon_attestation")
  createdAt         DateTime  @default(now()) @map("created_at")

  exam      Exam       @relation(fields: [examId], references: [id])
  user      User       @relation(fields: [userId], references: [id])
  events    Event[]
  artifacts Artifact[]
  flags     Flag[]

  @@map("sessions")
}

model Event {
  id          String   @id @default(uuid())
  sessionId   String   @map("session_id")
  timestamp   DateTime
  type        String
  payloadJson String   @map("payload_json") // JSON as text
  severity    String   @default("LOW")
  createdAt   DateTime @default(now()) @map("created_at")

  session Session @relation(fields: [sessionId], references: [id])
  flags   Flag[]

  @@index([sessionId, timestamp])
  @@map("events")
}

model Artifact {
  id        String   @id @default(uuid())
  sessionId String   @map("session_id")
  type      String
  s3Path    String   @map("s3_path")
  createdAt DateTime @default(now()) @map("created_at")

  session Session @relation(fields: [sessionId], references: [id])

  @@map("artifacts")
}

model Flag {
  id         String    @id @default(uuid())
  sessionId  String    @map("session_id")
  eventId    String?   @map("event_id")
  ruleId     String    @map("rule_id")
  confidence Float
  severity   String
  notes      String?
  resolvedBy String?   @map("resolved_by")
  resolvedAt DateTime? @map("resolved_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  session Session @relation(fields: [sessionId], references: [id])
  event   Event?  @relation(fields: [eventId], references: [id])

  @@map("flags")
}
